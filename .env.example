# Runtime
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/legend_casino
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
BUSINESS_TIMEZONE=Asia/Kolkata
CURRENCY=INR

# The application is intentionally safe by default. Do not enable real-money
# processing until the required licences, age/KYC controls, and payment-provider
# agreement are in place.
APP_MODE=demo
REAL_MONEY_ENABLED=false

# Local-only password reset aid. Never enable this on a production host; wire a
# verified email/SMS delivery provider before offering resets to real users.
OTP_DEVELOPMENT_MODE=false

# Optional visible support channels.
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
SUPPORT_WHATSAPP=

# Licensed partner providers. A provider remains unavailable until all three of
# its variables are supplied and its ENABLED value is true. Do not put actual
# keys in this tracked template.
PROVIDER_JILI_ENABLED=false
JILI_LAUNCH_URL=
JILI_CALLBACK_SECRET=
PROVIDER_JDB_ENABLED=false
JDB_LAUNCH_URL=
JDB_CALLBACK_SECRET=
PROVIDER_AVIATOR_ENABLED=false
AVIATOR_LAUNCH_URL=
AVIATOR_CALLBACK_SECRET=

# Create the first privileged user with `npm run seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional MySQL import source. This must be a fresh, untracked local file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=legend_importer
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=legend_casino
